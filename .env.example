# Copy to .env (`make setup` does this for you). .env is git-ignored; never commit secrets.
# Every setting is explained in docs/01-setup.md and read by app/config.py.

# Which model backend to use: "ollama" (local) or "bedrock" (AWS).
PROVIDER=ollama

# Postgres + pgvector. "localhost" from your Mac; docker compose overrides this
# to "postgres" (the service name) for containers.
DATABASE_URL=postgresql://rag:rag@localhost:5432/trials

# Ollama runs natively on your Mac (Docker on macOS can't use the GPU).
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024

# How many trials retrieval hands to the model.
TOP_K=8

# Only used when PROVIDER=bedrock (Phase 4).
AWS_REGION=eu-central-1
